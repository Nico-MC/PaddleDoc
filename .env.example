# paddledoc runtime tuning (docker compose)
# Copy to .env and adjust for your host.

# -----------------------------
# Required for Encourage RAG run
# -----------------------------
# OpenAI-compatible base URL (without trailing /v1 is okay)
# Examples:
# - https://api.openai.com
# - http://host.docker.internal:11434
OPENAI_API_BASE_URL=

# API key / bearer token for the endpoint above
OPENAI_API_BEARER_TOKEN=

# Optional: model used by Encourage one-shot inference on ingest
PADDLEDOC_ENCOURAGE_MODEL_NAME=gpt-4o-mini

# Optional frontend API URL override (mostly for NAS/prebuilt images)
PADDLEDOC_PUBLIC_API_URL=http://localhost:8000

# -----------------------------
# Optional NAS / prebuilt image settings
# -----------------------------
PADDLEDOC_TAG=latest
POSTGRES_DB=paddledoc
POSTGRES_USER=paddledoc
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
CORS_ORIGINS=["*"]
PADDLE_DEFAULT_PROFILE=ppocrv6_tiny

# Worker container resource limits
WORKER_MEMORY_LIMIT=3g
WORKER_CPUS=2.0

# Celery worker tuning
CELERY_WORKER_CONCURRENCY=1
CELERY_PREFETCH_MULTIPLIER=1
CELERY_MAX_TASKS_PER_CHILD=20
CELERY_LOG_LEVEL=info

# ONNX / OpenMP memory+CPU tuning (especially helpful on small ARM hosts)
OMP_NUM_THREADS=1
ONNXRUNTIME_INTRA_OP_NUM_THREADS=1
ONNXRUNTIME_INTER_OP_NUM_THREADS=1
MALLOC_ARENA_MAX=2

# Optional corporate proxy settings for Docker build/runtime
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,.local
