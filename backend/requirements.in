# Direct dependencies of the backend/API image (see Dockerfile) and of the
# local development environment. The pinned + hashed lock lives in
# requirements.txt. Regenerate it from the backend/ directory with
# (linux/amd64 matches the published image):
#
#   docker run --rm --platform linux/amd64 -v "$PWD":/work python:3.13-slim sh -c \
#     "pip install -q pip-tools && cd /work && pip-compile requirements.in \
#        -o requirements.txt --generate-hashes --allow-unsafe --no-strip-extras"
#
# Version pins stay here; the lock adds the transitive tree and the artifact
# hashes that make `pip install --require-hashes` refuse a swapped package.
--extra-index-url https://download.pytorch.org/whl/cpu
